{
  "manifest_version": 3,
  "name": "DSA Auto Tracker",
  "version": "0.1.0",
  "description": "Automatically marks Striver sheet problems as Done when you solve them on LeetCode.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://leetcode.com/*", "https://takeuforward.org/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content-leetcode.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://takeuforward.org/*"],
      "js": ["content-striver.js"],
      "run_at": "document_idle"
    }
  ]
}
